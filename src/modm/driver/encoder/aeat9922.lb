def init(module):
    module.name = ":driver:aeat9922"
    module.description = """\
# AEAT-9922 Absolute Magnetic Encoder SPI Driver

The Broadcom AEAT-9922 is a programmable magnetic rotary encoder that provides
absolute angular measurements over a full 360 degrees. It supports both on-axis
(end-of-shaft) and off-axis (side-of-shaft) magnet configurations.

Key features:
- Programmable absolute resolution from 10 to 18 bits
- Absolute output through SSI, SPI, or PWM
- Incremental ABI output from 1 to 10,000 counts per revolution
- UVW commutation output with 1 to 32 pole pairs
- Programmable zero position, direction, index width, and index position
- Programmable hysteresis and INL angle correction
- Magnet strength, initialization, and error indication
- 3.3V and 5V operation
- Operating temperature range from -40 C to 125 C
- Compact 4 mm x 4 mm QFN-24 package

This module implements the four-wire SPI4(A) interface for reading absolute
position data with 10 to 18 bit resolution and checking the encoder status.
The driver configures the volatile absolute resolution and on-axis/off-axis
magnet mode fields during initialization from template parameters.

[Datasheet](https://docs.broadcom.com/doc/AEAT-9922-Programmable-Angular-Magnetic-Encoder-IC-DS)
"""


def prepare(module, options):
    module.depends(
        ":architecture:delay",
        ":architecture:gpio",
        ":architecture:register",
        ":architecture:spi.device",
        ":architecture:fiber",
        ":math:geometry",
    )
    return True


def build(env):
    env.outbasepath = "modm/src/modm/driver/encoder"
    env.copy("aeat9922.hpp")
    env.copy("aeat9922_impl.hpp")
