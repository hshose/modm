#include "hrtim_{{ id }}.hpp"
#include <modm/platform/clock/rcc.hpp>

namespace
{

using Hrtim = modm::platform::Hrtim{{ id }};

uint32_t
updateMask(Hrtim::TimerCounter_t timers)
{
	uint32_t mask = 0;
	if (timers & Hrtim::TimerCounter::Master) mask |= HRTIM_CR2_MSWU;
	if (timers & Hrtim::TimerCounter::A) mask |= HRTIM_CR2_TASWU;
	if (timers & Hrtim::TimerCounter::B) mask |= HRTIM_CR2_TBSWU;
	if (timers & Hrtim::TimerCounter::C) mask |= HRTIM_CR2_TCSWU;
	if (timers & Hrtim::TimerCounter::D) mask |= HRTIM_CR2_TDSWU;
	if (timers & Hrtim::TimerCounter::E) mask |= HRTIM_CR2_TESWU;
%% if hrtim_has_timer_f
	if (timers & Hrtim::TimerCounter::F) mask |= HRTIM_CR2_TFSWU;
%% endif
	return mask;
}

uint32_t
resetMask(Hrtim::TimerCounter_t timers)
{
	uint32_t mask = 0;
	if (timers & Hrtim::TimerCounter::Master) mask |= HRTIM_CR2_MRST;
	if (timers & Hrtim::TimerCounter::A) mask |= HRTIM_CR2_TARST;
	if (timers & Hrtim::TimerCounter::B) mask |= HRTIM_CR2_TBRST;
	if (timers & Hrtim::TimerCounter::C) mask |= HRTIM_CR2_TCRST;
	if (timers & Hrtim::TimerCounter::D) mask |= HRTIM_CR2_TDRST;
	if (timers & Hrtim::TimerCounter::E) mask |= HRTIM_CR2_TERST;
%% if hrtim_has_timer_f
	if (timers & Hrtim::TimerCounter::F) mask |= HRTIM_CR2_TFRST;
%% endif
	return mask;
}

constexpr uint32_t
bit(uint8_t position)
{
	return 1ul << position;
}

} // namespace

// ----------------------------------------------------------------------------
void
modm::platform::Hrtim{{ id }}::enable()
{
	Rcc::enable<Peripheral::{{ peripheral }}>();
}

void
modm::platform::Hrtim{{ id }}::disable()
{
	HRTIM{{ id }}->sCommonRegs.ODISR = HRTIM_ODISR_TA1ODIS | HRTIM_ODISR_TA2ODIS |
			HRTIM_ODISR_TB1ODIS | HRTIM_ODISR_TB2ODIS |
			HRTIM_ODISR_TC1ODIS | HRTIM_ODISR_TC2ODIS |
			HRTIM_ODISR_TD1ODIS | HRTIM_ODISR_TD2ODIS |
			HRTIM_ODISR_TE1ODIS | HRTIM_ODISR_TE2ODIS
%% if hrtim_has_timer_f
			| HRTIM_ODISR_TF1ODIS | HRTIM_ODISR_TF2ODIS
%% endif
			;
	HRTIM{{ id }}->sCommonRegs.IER = 0;
	HRTIM{{ id }}->sCommonRegs.CR1 = 0;
	HRTIM{{ id }}->sCommonRegs.CR2 = 0;
	HRTIM{{ id }}->sCommonRegs.ADC1R = 0;
	HRTIM{{ id }}->sCommonRegs.ADC2R = 0;
	HRTIM{{ id }}->sCommonRegs.ADC3R = 0;
	HRTIM{{ id }}->sCommonRegs.ADC4R = 0;

	HRTIM{{ id }}->sMasterRegs.MCR = 0;
	HRTIM{{ id }}->sMasterRegs.MDIER = 0;

	for (auto& regs : HRTIM{{ id }}->sTimerxRegs)
	{
		regs.TIMxCR = 0;
		regs.TIMxDIER = 0;
		regs.SETx1R = 0;
		regs.RSTx1R = 0;
		regs.SETx2R = 0;
		regs.RSTx2R = 0;
		regs.OUTxR = 0;
	}

	Rcc::disable<Peripheral::{{ peripheral }}>();
}

bool
modm::platform::Hrtim{{ id }}::isEnabled()
{
	return Rcc::isEnabled<Peripheral::{{ peripheral }}>();
}

%% if hrtim_has_dll_calibration
bool
modm::platform::Hrtim{{ id }}::calibrate(uint32_t timeout)
{
	HRTIM{{ id }}->sCommonRegs.ICR = HRTIM_ICR_DLLRDYC;
	HRTIM{{ id }}->sCommonRegs.DLLCR =
			(HRTIM{{ id }}->sCommonRegs.DLLCR & ~HRTIM_DLLCR_CALRTE_Msk) |
			HRTIM_DLLCR_CALRTE | HRTIM_DLLCR_CAL;

	while (!isCalibrationReady())
	{
		if (timeout-- == 0) {
			return false;
		}
	}
	return true;
}

bool
modm::platform::Hrtim{{ id }}::isCalibrationReady()
{
	return (HRTIM{{ id }}->sCommonRegs.ISR & HRTIM_ISR_DLLRDY) != 0;
}

%% endif
// ----------------------------------------------------------------------------
void
modm::platform::Hrtim{{ id }}::setMode(Timer timer, Prescaler prescaler,
		bool preload, bool continuous, bool updateOnRepetition)
{
	uint32_t cr = static_cast<uint32_t>(prescaler) & HRTIM_TIMCR_CK_PSC;
	if (continuous) {
		cr |= HRTIM_TIMCR_CONT;
	}
	if (preload) {
		cr |= HRTIM_TIMCR_PREEN;
	}
	if (updateOnRepetition) {
		cr |= HRTIM_TIMCR_TREPU;
	}

	timerRegisters(timer).TIMxCR = cr;
}

void
modm::platform::Hrtim{{ id }}::applyUpdate(TimerCounter_t timers)
{
	HRTIM{{ id }}->sCommonRegs.CR2 = updateMask(timers);
}

void
modm::platform::Hrtim{{ id }}::reset(TimerCounter_t timers)
{
	HRTIM{{ id }}->sCommonRegs.CR2 = resetMask(timers);
}

void
modm::platform::Hrtim{{ id }}::applyAndReset(TimerCounter_t timers)
{
	HRTIM{{ id }}->sCommonRegs.CR2 = updateMask(timers) | resetMask(timers);
}

// ----------------------------------------------------------------------------
uint32_t
modm::platform::Hrtim{{ id }}::adcTriggerSourceMask(AdcTrigger trigger,
		AdcTriggerSource source)
{
%% if hrtim_driver_type == "stm32-hrtim_g4"
	switch (source)
	{
		case AdcTriggerSource::MasterCompare1: return bit(0);
		case AdcTriggerSource::MasterCompare2: return bit(1);
		case AdcTriggerSource::MasterCompare3: return bit(2);
		case AdcTriggerSource::MasterCompare4: return bit(3);
		case AdcTriggerSource::MasterPeriod: return bit(4);

		case AdcTriggerSource::ExternalEvent1: return isAdcTrigger13(trigger) ? bit(5) : 0;
		case AdcTriggerSource::ExternalEvent2: return isAdcTrigger13(trigger) ? bit(6) : 0;
		case AdcTriggerSource::ExternalEvent3: return isAdcTrigger13(trigger) ? bit(7) : 0;
		case AdcTriggerSource::ExternalEvent4: return isAdcTrigger13(trigger) ? bit(8) : 0;
		case AdcTriggerSource::ExternalEvent5: return isAdcTrigger13(trigger) ? bit(9) : 0;
		case AdcTriggerSource::ExternalEvent6: return isAdcTrigger24(trigger) ? bit(5) : 0;
		case AdcTriggerSource::ExternalEvent7: return isAdcTrigger24(trigger) ? bit(6) : 0;
		case AdcTriggerSource::ExternalEvent8: return isAdcTrigger24(trigger) ? bit(7) : 0;
		case AdcTriggerSource::ExternalEvent9: return isAdcTrigger24(trigger) ? bit(8) : 0;
		case AdcTriggerSource::ExternalEvent10: return isAdcTrigger24(trigger) ? bit(9) : 0;

		case AdcTriggerSource::TimerACompare2: return isAdcTrigger24(trigger) ? bit(10) : 0;
		case AdcTriggerSource::TimerACompare3: return isAdcTrigger13(trigger) ? bit(11) : 0;
		case AdcTriggerSource::TimerACompare4: return bit(12);
		case AdcTriggerSource::TimerAPeriod: return bit(13);
		case AdcTriggerSource::TimerAReset: return isAdcTrigger13(trigger) ? bit(14) : 0;

		case AdcTriggerSource::TimerBCompare2: return isAdcTrigger24(trigger) ? bit(14) : 0;
		case AdcTriggerSource::TimerBCompare3: return isAdcTrigger13(trigger) ? bit(16) : 0;
		case AdcTriggerSource::TimerBCompare4: return isAdcTrigger13(trigger) ? bit(17) : bit(16);
		case AdcTriggerSource::TimerBPeriod: return isAdcTrigger13(trigger) ? bit(18) : bit(17);
		case AdcTriggerSource::TimerBReset: return isAdcTrigger13(trigger) ? bit(19) : 0;

		case AdcTriggerSource::TimerCCompare2: return isAdcTrigger24(trigger) ? bit(18) : 0;
		case AdcTriggerSource::TimerCCompare3: return isAdcTrigger13(trigger) ? bit(21) : 0;
		case AdcTriggerSource::TimerCCompare4: return isAdcTrigger13(trigger) ? bit(22) : bit(20);
		case AdcTriggerSource::TimerCPeriod: return isAdcTrigger13(trigger) ? bit(23) : bit(21);
		case AdcTriggerSource::TimerCReset: return isAdcTrigger24(trigger) ? bit(22) : 0;

		case AdcTriggerSource::TimerDCompare2: return isAdcTrigger24(trigger) ? bit(23) : 0;
		case AdcTriggerSource::TimerDCompare3: return isAdcTrigger13(trigger) ? bit(25) : 0;
		case AdcTriggerSource::TimerDCompare4: return isAdcTrigger13(trigger) ? bit(26) : bit(25);
		case AdcTriggerSource::TimerDPeriod: return isAdcTrigger13(trigger) ? bit(27) : bit(26);
		case AdcTriggerSource::TimerDReset: return isAdcTrigger24(trigger) ? bit(27) : 0;

		case AdcTriggerSource::TimerECompare2: return isAdcTrigger24(trigger) ? bit(28) : 0;
		case AdcTriggerSource::TimerECompare3: return bit(29);
		case AdcTriggerSource::TimerECompare4: return bit(30);
		case AdcTriggerSource::TimerEPeriod: return isAdcTrigger13(trigger) ? bit(31) : 0;
		case AdcTriggerSource::TimerEReset: return isAdcTrigger24(trigger) ? bit(31) : 0;

		case AdcTriggerSource::TimerFCompare2: return isAdcTrigger13(trigger) ? bit(10) : bit(11);
		case AdcTriggerSource::TimerFCompare3: return bit(15);
		case AdcTriggerSource::TimerFCompare4: return isAdcTrigger13(trigger) ? bit(20) : bit(19);
		case AdcTriggerSource::TimerFPeriod: return bit(24);
		case AdcTriggerSource::TimerFReset: return isAdcTrigger13(trigger) ? bit(28) : 0;
	}
%% else
	switch (source)
	{
		case AdcTriggerSource::MasterCompare1: return bit(0);
		case AdcTriggerSource::MasterCompare2: return bit(1);
		case AdcTriggerSource::MasterCompare3: return bit(2);
		case AdcTriggerSource::MasterCompare4: return bit(3);
		case AdcTriggerSource::MasterPeriod: return bit(4);

		case AdcTriggerSource::ExternalEvent1: return isAdcTrigger13(trigger) ? bit(5) : 0;
		case AdcTriggerSource::ExternalEvent2: return isAdcTrigger13(trigger) ? bit(6) : 0;
		case AdcTriggerSource::ExternalEvent3: return isAdcTrigger13(trigger) ? bit(7) : 0;
		case AdcTriggerSource::ExternalEvent4: return isAdcTrigger13(trigger) ? bit(8) : 0;
		case AdcTriggerSource::ExternalEvent5: return isAdcTrigger13(trigger) ? bit(9) : 0;
		case AdcTriggerSource::ExternalEvent6: return isAdcTrigger24(trigger) ? bit(5) : 0;
		case AdcTriggerSource::ExternalEvent7: return isAdcTrigger24(trigger) ? bit(6) : 0;
		case AdcTriggerSource::ExternalEvent8: return isAdcTrigger24(trigger) ? bit(7) : 0;
		case AdcTriggerSource::ExternalEvent9: return isAdcTrigger24(trigger) ? bit(8) : 0;
		case AdcTriggerSource::ExternalEvent10: return isAdcTrigger24(trigger) ? bit(9) : 0;

		case AdcTriggerSource::TimerACompare2: return bit(10);
		case AdcTriggerSource::TimerACompare3: return bit(11);
		case AdcTriggerSource::TimerACompare4: return bit(12);
		case AdcTriggerSource::TimerAPeriod: return bit(13);
		case AdcTriggerSource::TimerAReset: return isAdcTrigger13(trigger) ? bit(14) : 0;

		case AdcTriggerSource::TimerBCompare2: return isAdcTrigger13(trigger) ? bit(15) : bit(14);
		case AdcTriggerSource::TimerBCompare3: return isAdcTrigger13(trigger) ? bit(16) : bit(15);
		case AdcTriggerSource::TimerBCompare4: return isAdcTrigger13(trigger) ? bit(17) : bit(16);
		case AdcTriggerSource::TimerBPeriod: return isAdcTrigger13(trigger) ? bit(18) : bit(17);
		case AdcTriggerSource::TimerBReset: return isAdcTrigger13(trigger) ? bit(19) : 0;

		case AdcTriggerSource::TimerCCompare2: return isAdcTrigger13(trigger) ? bit(20) : bit(18);
		case AdcTriggerSource::TimerCCompare3: return isAdcTrigger13(trigger) ? bit(21) : bit(19);
		case AdcTriggerSource::TimerCCompare4: return isAdcTrigger13(trigger) ? bit(22) : bit(20);
		case AdcTriggerSource::TimerCPeriod: return isAdcTrigger13(trigger) ? bit(23) : bit(21);
		case AdcTriggerSource::TimerCReset: return isAdcTrigger24(trigger) ? bit(22) : 0;

		case AdcTriggerSource::TimerDCompare2: return isAdcTrigger13(trigger) ? bit(24) : bit(23);
		case AdcTriggerSource::TimerDCompare3: return isAdcTrigger13(trigger) ? bit(25) : bit(24);
		case AdcTriggerSource::TimerDCompare4: return isAdcTrigger13(trigger) ? bit(26) : bit(25);
		case AdcTriggerSource::TimerDPeriod: return isAdcTrigger13(trigger) ? bit(27) : bit(26);
		case AdcTriggerSource::TimerDReset: return isAdcTrigger24(trigger) ? bit(27) : 0;

		case AdcTriggerSource::TimerECompare2: return bit(28);
		case AdcTriggerSource::TimerECompare3: return bit(29);
		case AdcTriggerSource::TimerECompare4: return bit(30);
		case AdcTriggerSource::TimerEPeriod: return isAdcTrigger13(trigger) ? bit(31) : 0;
		case AdcTriggerSource::TimerEReset: return isAdcTrigger24(trigger) ? bit(31) : 0;
	}
%% endif
	return 0;
}

bool
modm::platform::Hrtim{{ id }}::configureAdcTrigger(AdcTrigger trigger,
		AdcTriggerSource source, AdcTriggerUpdateSource updateSource)
{
	std::span<const AdcTriggerSource> sources(&source, 1);
	return configureAdcTrigger(trigger, sources, updateSource);
}

bool
modm::platform::Hrtim{{ id }}::configureAdcTrigger(AdcTrigger trigger,
		std::span<const AdcTriggerSource> sources, AdcTriggerUpdateSource updateSource)
{
	uint32_t config = 0;
	for (const auto source : sources)
	{
		const uint32_t mask = adcTriggerSourceMask(trigger, source);
		if (mask == 0) {
			return false;
		}
		config |= mask;
	}

	adcTriggerRegister(trigger) = config;
	setAdcTriggerUpdateSource(trigger, updateSource);
	return true;
}

bool
modm::platform::Hrtim{{ id }}::addAdcTriggerSource(AdcTrigger trigger,
		AdcTriggerSource source)
{
	const uint32_t mask = adcTriggerSourceMask(trigger, source);
	if (mask == 0) {
		return false;
	}
	adcTriggerRegister(trigger) |= mask;
	return true;
}

void
modm::platform::Hrtim{{ id }}::clearAdcTrigger(AdcTrigger trigger)
{
	adcTriggerRegister(trigger) = 0;
}

uint32_t
modm::platform::Hrtim{{ id }}::getAdcTriggerConfig(AdcTrigger trigger)
{
	return adcTriggerRegister(trigger);
}

void
modm::platform::Hrtim{{ id }}::setAdcTriggerUpdateSource(AdcTrigger trigger,
		AdcTriggerUpdateSource source)
{
	const uint32_t mask = adcTriggerUpdateSourceMask(trigger);
	HRTIM{{ id }}->sCommonRegs.CR1 =
			(HRTIM{{ id }}->sCommonRegs.CR1 & ~mask) |
			adcTriggerUpdateSource(trigger, source);
}

// ----------------------------------------------------------------------------
void
modm::platform::Hrtim{{ id }}::configureOutput(Timer timer, Output output,
		OutputEvent_t setSource, OutputEvent_t resetSource,
		OutputPolarity polarity, bool enable)
{
	auto& regs = timerRegisters(timer);
	const uint32_t polarityMask = outputPolarityMask(output);

	if (output == Output::Output1)
	{
		regs.SETx1R = setSource.value;
		regs.RSTx1R = resetSource.value;
	}
	else
	{
		regs.SETx2R = setSource.value;
		regs.RSTx2R = resetSource.value;
	}

	uint32_t out = regs.OUTxR & ~polarityMask;
	if (polarity == OutputPolarity::ActiveLow) {
		out |= polarityMask;
	}
	regs.OUTxR = out;

	if (enable) {
		enableOutput(timer, output);
	}
	else {
		disableOutput(timer, output);
	}
}

void
modm::platform::Hrtim{{ id }}::configurePwm(Timer timer, Output output,
		CompareUnit compare, Value compareValue,
		OutputPolarity polarity, bool inverted, bool enable)
{
	setCompareValue(timer, compare, compareValue);

	const OutputEvent_t compareSource(compareEvent(compare));
	const OutputEvent_t periodSource(OutputEvent::Period);
	configureOutput(timer, output,
			inverted ? compareSource : periodSource,
			inverted ? periodSource : compareSource,
			polarity, enable);
}

void
modm::platform::Hrtim{{ id }}::setOutputState(Timer timer, Output output,
		OutputState state, CompareUnit compare, bool inverted)
{
	const auto polarity = getOutputPolarity(timer, output);

	switch (state)
	{
		case OutputState::Pwm:
		{
			const OutputEvent_t compareSource(compareEvent(compare));
			const OutputEvent_t periodSource(OutputEvent::Period);
			configureOutput(timer, output,
					inverted ? compareSource : periodSource,
					inverted ? periodSource : compareSource,
					polarity, true);
			break;
		}
		case OutputState::Low:
		case OutputState::High:
		{
			const bool activeHigh = (polarity == OutputPolarity::ActiveHigh);
			const bool setActive = (state == OutputState::High) == activeHigh;
			configureOutput(timer, output,
					setActive ? OutputEvent::Software : OutputEvent::None,
					setActive ? OutputEvent::None : OutputEvent::Software,
					polarity, true);
			break;
		}
		case OutputState::HiZ:
			disableOutput(timer, output);
			break;
	}
}

void
modm::platform::Hrtim{{ id }}::setDeadTime(Timer timer, uint16_t rising,
		uint16_t falling, DeadTimePrescaler prescaler)
{
	timerRegisters(timer).DTxR =
			(static_cast<uint32_t>(rising) & 0x1fful) |
			((static_cast<uint32_t>(falling) & 0x1fful) << HRTIM_DTR_DTF_Pos) |
			static_cast<uint32_t>(prescaler);
	enableDeadTime(timer);
}

void
modm::platform::Hrtim{{ id }}::enableDeadTime(Timer timer, bool enable)
{
	auto& regs = timerRegisters(timer);
	if (enable) {
		regs.OUTxR |= HRTIM_OUTR_DTEN;
	}
	else {
		regs.OUTxR &= ~HRTIM_OUTR_DTEN;
	}
}

modm::platform::Hrtim{{ id }}::OutputPolarity
modm::platform::Hrtim{{ id }}::getOutputPolarity(Timer timer, Output output)
{
	return (timerRegisters(timer).OUTxR & outputPolarityMask(output))
			? OutputPolarity::ActiveLow : OutputPolarity::ActiveHigh;
}
